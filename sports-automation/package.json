{
  "name": "sports-automation",
  "version": "1.0.0",
  "description": "Football Shorts Automation Pipeline (zero-cost edition) — Ollama + Pollinations + Piper + FFmpeg, publishes to a Facebook Page as a Reel",
  "type": "module",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "test-run": "node scripts/test-run.js",
    "check-deps": "node scripts/check-deps.js",
    "admin": "node scripts/admin-only.js",
    "test": "node --test tests/**/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tensorflow-models/blazeface": "^0.1.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fluent-ffmpeg": "^2.1.3",
    "jimp": "^1.6.1",
    "node-cron": "^3.0.3",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "rss-parser": "^3.13.0"
  }
}
