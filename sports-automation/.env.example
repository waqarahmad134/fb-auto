# ── General ──────────────────────────────
NODE_ENV=production
CRON_SCHEDULE=*/30 * * * *       # every 30 minutes
DATA_DIR=./data                  # local JSON storage for articles/runs — no database needed
OUTPUT_RETENTION_DAYS=3
DRY_RUN=false                    # true = do everything EXCEPT upload/post
ADMIN_PORT=4321                  # local admin dashboard: http://localhost:4321

# ── RSS ──────────────────────────────────
RSS_FEEDS=https://www.espn.com/espn/rss/soccer/news,https://feeds.bbci.co.uk/sport/football/rss.xml,https://www.skysports.com/rss/12040

# ── Ollama (local LLM) ───────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=120000         # local inference can be slow on CPU

# ── Pollinations (image gen, no key) ─────
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
IMAGE_WIDTH=768
IMAGE_HEIGHT=1344
# Use the real photo from the article/RSS feed first, before generating an AI image.
# WARNING: real news photos show identifiable people/team crests and are typically
# licensed to the publication, not you — this carries copyright/publicity-rights risk.
# Default false: always generate an original AI image instead (no logos/branding).
USE_ARTICLE_IMAGE=false
FONT_PATH=./assets/fonts/Anton-Regular.ttf   # headline/subtext overlay font (step 06)

# ── Piper (local TTS) ────────────────────
PIPER_BIN=./assets/piper/piper   # piper.exe on Windows
PIPER_VOICE=./assets/piper/en_US-ryan-high.onnx
PIPER_LENGTH_SCALE=1.0           # >1.0 slower speech, <1.0 faster

# ── Facebook ─────────────────────────────
# The only publish target — there is no YouTube upload step. If either of these is
# blank, step 08 skips gracefully (logs a warning) instead of failing the run.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=            # long-lived Page token with pages_manage_posts, pages_read_engagement
